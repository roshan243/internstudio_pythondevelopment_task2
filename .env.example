# Copy this file to .env and provide your SMTP provider's settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_app_password
SMTP_SENDER=reports@example.com
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_TIMEOUT=20

# Optional paths; relative paths are resolved from this project directory.
# REPORT_DATABASE_PATH=data/reports.db
# REPORTS_DIR=reports
# ARCHIVE_DIR=archive
# LOGS_DIR=logs
